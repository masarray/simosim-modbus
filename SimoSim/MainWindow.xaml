<Window x:Class="SimoSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hmi="clr-namespace:HMI.Controls;assembly=HMI.Controls"
        Title="Simocode Modbus Simulator"
        Height="594"
        Width="793"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="/factory.png">

    <Window.Resources>

        <Style x:Key="IndustrialButton" TargetType="Button">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#444"/>
            <Setter Property="BorderBrush" Value="#222"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                    Property="Background"
                                    Value="#666"/>
                            </Trigger>

                            <!-- Pressed -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border"
                                    Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96"
                                                    ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- ================= ROWS ================= -->
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- ======================= HEADER ======================= -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0">

            <Label Content="Nama Feeder:"
                   Margin="10,8,0,0"
                   VerticalAlignment="Top"/>

            <ComboBox x:Name="txtFeeder"
                      IsEditable="True"
                      Width="201"
                      Height="22"
                      Margin="95,10,0,38"
                      HorizontalAlignment="Left"
                      Text="SIMOCODE"/>

            <Label Content="IP Address:"
                   Margin="10,38,0,0"
                   VerticalAlignment="Top"/>

            <ComboBox x:Name="txtIP"
                      IsEditable="True"
                      Width="87"
                      Height="22"
                      Margin="95,40,0,8"
                      HorizontalAlignment="Left"
                      Text="127.0.0.1"/>

            <Label Content="Unit ID:"
                   Margin="196,38,246,0"
                   VerticalAlignment="Top"/>

            <ComboBox x:Name="txtUnitID"
                      IsEditable="True"
                      Width="50"
                      Height="22"
                      Margin="246,40,0,8"
                      HorizontalAlignment="Left"
                      Text="1"/>

            <Button x:Name="btnStartTcp"
                    Style="{StaticResource IndustrialButton}"
                    Content="Start Modbus TCP Slave"
                    Width="163"
                    Margin="301,5,0,33"
                    HorizontalAlignment="Left"
                    Background="LightCoral"
                    Foreground="White"
                    Click="BtnStartTcp_Click" Height="25"/>


        </Grid>


        <!-- ===================================================== -->
        <!-- ===================== MIMIC AREA ===================== -->
        <!-- ===================================================== -->

        <Canvas Grid.Row="1" Background="White">

            <!-- BUS BAR -->
            <Rectangle Canvas.Left="169"
                       Canvas.Top="13"
                       Width="100"
                       Height="6"
                       Fill="Black"/>

            <!-- VERTICAL LINE -->
            <Rectangle Canvas.Left="216"
                       Canvas.Top="18"
                       Width="6"
                       Height="134"
                       Fill="Black" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <!-- CB CONTROL -->
            <hmi:CbControl x:Name="CB1"
                           Width="100"
                           Height="100"
                           Canvas.Left="169"
                           Canvas.Top="40" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top">
                <hmi:CbControl.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </hmi:CbControl.RenderTransform>
            </hmi:CbControl>

            <TextBlock Text="CB"
                       Canvas.Left="222"
                       Canvas.Top="35"
                       FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <!-- MOTOR -->
            <Ellipse x:Name="ellipseMotor"
                     Canvas.Left="180"
                     Canvas.Top="148"
                     Width="80"
                     Height="80"
                     Stroke="Black"
                     StrokeThickness="3"
                     Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <TextBlock Text="MOTOR"
                       Canvas.Left="199"
                       Canvas.Top="180"
                       FontWeight="Bold"/>

            <Border
        HorizontalAlignment="Center"
        Width="204"
        Background="#2E2E2E"
        CornerRadius="6"
        Padding="8" RenderTransformOrigin="0.5,0.5" Canvas.Left="280" Canvas.Top="-34" VerticalAlignment="Top">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Border.RenderTransform>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- TX -->
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <Ellipse x:Name="ledTx"
                     Width="14"
                     Height="14"
                     Fill="Gray"
                     Stroke="Black"/>
                        <TextBlock Text=" TX"
                       Foreground="White"
                       VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- RX -->
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <Ellipse x:Name="ledRx"
                     Width="14"
                     Height="14"
                     Fill="Gray"
                     Stroke="Black"/>
                        <TextBlock Text=" RX"
                       Foreground="White"
                       VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ERROR -->
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <Ellipse x:Name="ledComm"
                     Width="14"
                     Height="14"
                     Fill="Gray"
                     Stroke="Black"/>
                        <TextBlock Text=" COMM"
                       Foreground="White"
                       VerticalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <GroupBox Header="Modbus RTU Slave"
          Margin="10"
          Padding="10"
          FontWeight="SemiBold"
          BorderBrush="#2E8B57"
          BorderThickness="2" Canvas.Left="470">

                <StackPanel>

                    <!-- Row 1 -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="COM Port"
                       Width="100"
                       VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbComPort"
                      Width="120"
                      Height="28"
                      Margin="5,0"/>
                    </StackPanel>

                    <!-- Row 2 -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Baudrate"
                       Width="100"
                       VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbBaud"
                      Width="120"
                      Height="28"
                      Margin="5,0">
                            <ComboBoxItem Content="9600"/>
                            <ComboBoxItem Content="19200"/>
                            <ComboBoxItem Content="38400"/>
                            <ComboBoxItem Content="57600"/>
                            <ComboBoxItem Content="115200"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Row 3 -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Parity"
                       Width="100"
                       VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbParity"
                      Width="120"
                      Height="28"
                      Margin="5,0">
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="Even"/>
                            <ComboBoxItem Content="Odd"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Row 4 -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Data Bits"
                       Width="100"
                       VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbDataBits"
                      Width="120"
                      Height="28"
                      Margin="5,0">
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Row 5 -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Stop Bits"
                       Width="100"
                       VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbStopBits"
                      Width="120"
                      Height="28"
                      Margin="5,0">
                            <ComboBoxItem Content="One"/>
                            <ComboBoxItem Content="Two"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Row 6 -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Unit ID"
                       Width="100"
                       VerticalAlignment="Center"/>

                        <TextBox x:Name="txtRtuUnitID"
                     Width="120"
                     Height="28"
                     Margin="5,0"
                     Text="1"/>
                    </StackPanel>

                    <!-- Start Button -->
                    <Button x:Name="btnStartRtu"
                Content="Start Modbus RTU"
                Height="35"
                Margin="0,15,0,0"
                Background="LightCoral"
                Foreground="White"
                FontWeight="Bold"
                Click="BtnStartRtu_Click"/>
                    
                    

                </StackPanel>
            </GroupBox>

            <!-- ================= CONTROL PANEL ================= -->
            <Border Canvas.Left="300"
        Canvas.Top="11"
        Width="164"
        Background="#F0F0F0"
        BorderBrush="#CCCCCC"
        BorderThickness="1"
        CornerRadius="6"
        Padding="10" HorizontalAlignment="Center" VerticalAlignment="Top" Height="426">

                <StackPanel Margin="0,0,0,-113">

                    <TextBlock Text="CONTROL PANEL"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

                    <Button Content="CLOSE"
                Style="{StaticResource IndustrialButton}"
                Background="#D32F2F"
                Click="BtnClose_Click"/>

                    <Button Content="OPEN"
                Style="{StaticResource IndustrialButton}"
                Background="#388E3C"
                Click="BtnOpen_Click"/>

                    <Button Content="START"
                Style="{StaticResource IndustrialButton}"
                Background="#1976D2"
                Click="BtnStart_Click"/>

                    <Button Content="STOP"
                Style="{StaticResource IndustrialButton}"
                Background="#F57C00"
                Click="BtnStop_Click"/>

                    <Button x:Name="btnRemote"
        Content="REMOTE ON"
        Style="{StaticResource IndustrialButton}"
        Background="#1565C0"
        Click="BtnRemote_Click"/>

                    <Button x:Name="btnWarning"
        Content="WARNING"
        Style="{StaticResource IndustrialButton}"
        Background="#444"
        Click="BtnWarning_Click"/>

                    <Button x:Name="btnService"
        Content="SERVICE"
        Style="{StaticResource IndustrialButton}"
        Background="#444"
        Click="BtnService_Click"/>

                    <Button Content="FAULT INJECT"
                Style="{StaticResource IndustrialButton}"
                Background="#B71C1C"
                Click="BtnFault_Click"/>

                    <Button Content="RESET"
                Style="{StaticResource IndustrialButton}"
                Background="#FFFF00AF"
                Click="BtnReset_Click"/>

                </StackPanel>
            </Border>



            <!-- LEFT STATUS PANEL -->

            <!-- CURRENT DISPLAY -->

            <!-- ================= LED PANEL ================= -->
            <Border Canvas.Left="16"
        Canvas.Top="11"
        Width="120"
        Background="#F5F5F5"
        BorderBrush="#CCCCCC"
        BorderThickness="1"
        CornerRadius="6"
        Padding="10" HorizontalAlignment="Center" VerticalAlignment="Top">

                <StackPanel>

                    <!-- RUN -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Ellipse x:Name="ledRun"
                     Width="18"
                     Height="18"
                     Stroke="Black"
                     StrokeThickness="1"
                     Fill="Gray"/>
                        <TextBlock Text="RUN"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- STOP -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Ellipse x:Name="ledStop"
                     Width="18"
                     Height="18"
                     Stroke="Black"
                     StrokeThickness="1"
                     Fill="Gray"/>
                        <TextBlock Text="STOP"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- FAULT -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Ellipse x:Name="ledFault"
                     Width="18"
                     Height="18"
                     Stroke="Black"
                     StrokeThickness="1"
                     Fill="Gray"/>
                        <TextBlock Text="FAULT"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- WARNING -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Ellipse x:Name="ledWarning"
             Width="18"
             Height="18"
             Stroke="Black"
             StrokeThickness="1"
             Fill="Gray"/>
                        <TextBlock Text="WARNING"
               Margin="8,0,0,0"
               VerticalAlignment="Center"
               FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- REMOTE -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Ellipse x:Name="ledRemote"
                     Width="18"
                     Height="18"
                     Stroke="Black"
                     StrokeThickness="1"
                     Fill="Gray"/>
                        <TextBlock Text="REMOTE"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- SERVICE -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Ellipse x:Name="ledService"
                     Width="18"
                     Height="18"
                     Stroke="Black"
                     StrokeThickness="1"
                     Fill="Gray"/>
                        <TextBlock Text="SERVICE"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- CB CLOSE -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Ellipse x:Name="ledCbClose"
             Width="18"
             Height="18"
             Stroke="Black"
             StrokeThickness="1"
             Fill="Gray"/>
                        <TextBlock Text="CB CLOSE"
               Margin="8,0,0,0"
               VerticalAlignment="Center"
               FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- CB OPEN -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Ellipse x:Name="ledCbOpen"
             Width="18"
             Height="18"
             Stroke="Black"
             StrokeThickness="1"
             Fill="Gray"/>
                        <TextBlock Text="CB OPEN"
               Margin="8,0,0,0"
               VerticalAlignment="Center"
               FontWeight="SemiBold"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ================= MEASUREMENT PANEL ================= -->
            <Border Grid.Row="1"
        Background="#1E1E1E"
        CornerRadius="8"
        BorderBrush="#444"
        BorderThickness="1"
        Padding="15" Canvas.Left="15" Canvas.Top="260" Width="254" HorizontalAlignment="Left" VerticalAlignment="Center">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TITLE -->
                    <TextBlock Text="MEASUREMENTS"
                   Foreground="White"
                   FontWeight="Bold"
                   FontSize="13"
                   HorizontalAlignment="Center"/>

                    <!-- CONTENT -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- CURRENT -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="R" Foreground="Gray" FontSize="10"/>
                            <TextBlock x:Name="txtR"
                           Text="0.0 A"
                           Foreground="#00FF66"
                           FontSize="16"
                           FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="S" Foreground="Gray" FontSize="10"/>
                            <TextBlock x:Name="txtS"
                           Text="0.0 A"
                           Foreground="#00FF66"
                           FontSize="16"
                           FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="T" Foreground="Gray" FontSize="10"/>
                            <TextBlock x:Name="txtT"
                           Text="0.0 A"
                           Foreground="#00FF66"
                           FontSize="16"
                           FontWeight="Bold"/>
                        </StackPanel>

                        <!-- VOLTAGE -->
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="VRS" Foreground="Gray" FontSize="10"/>
                            <TextBlock x:Name="txtVRS"
                           Text="0 V"
                           Foreground="#33B5FF"
                           FontSize="14"
                           FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="VST" Foreground="Gray" FontSize="10"/>
                            <TextBlock x:Name="txtVST"
                           Text="0 V"
                           Foreground="#33B5FF"
                           FontSize="14"
                           FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="VTR" Foreground="Gray" FontSize="10"/>
                            <TextBlock x:Name="txtVTR"
                           Text="0 V"
                           Foreground="#33B5FF"
                           FontSize="14"
                           FontWeight="Bold"/>
                        </StackPanel>

                        <!-- POWER -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="P (kW)" Foreground="Gray" FontSize="10"/>
                            <TextBlock x:Name="txtP"
                           Text="0 kW"
                           Foreground="#FFA500"
                           FontSize="14"
                           FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="S (kVA)" Foreground="Gray" FontSize="10"/>
                            <TextBlock x:Name="txtSApp"
                           Text="0 kVA"
                           Foreground="#FFA500"
                           FontSize="14"
                           FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="PF" Foreground="Gray" FontSize="10"/>
                            <TextBlock x:Name="txtPF"
                           Text="0.00"
                           Foreground="#FFD700"
                           FontSize="14"
                           FontWeight="Bold"/>
                        </StackPanel>

                    </Grid>
                </Grid>

            </Border>
        </Canvas>

        <!-- ===================================================== -->
        <!-- ===================== STATUS BAR ===================== -->
        <!-- ===================================================== -->

        <StatusBar Grid.Row="2" Background="#2E2E2E">

            <StatusBarItem>
                <TextBlock x:Name="txtStatus"
                   Text="Stopped"
                   Foreground="Red"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock x:Name="txtCommInfo"
                   Text="TX:0 RX:0 0ms"
                   Foreground="White"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Mas Ari Modbus Slave Sim (c) 2026"
                   Foreground="White"
                   FontStyle="Italic"/>
            </StatusBarItem>

        </StatusBar>
    </Grid>
</Window>